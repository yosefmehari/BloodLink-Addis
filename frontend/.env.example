# ==========================================
# BloodLink Addis - Environment Variables
# ==========================================

# Neon PostgreSQL connection string (pooled recommended for serverless)
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require"

# Cryptographic secret for signing session tokens (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# Environment
NODE_ENV="development"
